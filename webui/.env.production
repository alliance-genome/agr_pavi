# Defaults loaded by `next start` (production mode). This file is read on BOTH
# Vercel and the self-hosted EC2 box, so it must NOT force mock data — otherwise
# a box restart can silently boot serving fake data.
#
# MOCK_API is false here on purpose. Vercel preview deployments still run with
# MOCK_API=true because vercel.json sets it, and platform env overrides this
# file — so Percy visual tests stay self-contained while production stays real.
MOCK_API=false

# On the box, PAVI_API_BASE_URL is supplied by the start command
# (e.g. PAVI_API_BASE_URL=http://localhost:8000). Left unset here.
# PAVI_API_BASE_URL=http://localhost:8000
